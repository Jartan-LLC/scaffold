[@NAME@]
name=@NAME@
# TODO(/onboard): replace ORG/REPO with the GitHub org and repo. With a custom domain for GitHub Pages, write https://DOMAIN/rpm/ instead.
baseurl=https://ORG.github.io/REPO/rpm/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-@NAME@
auto_import_local_keys=1
metadata_expire=6h
