{
  // Pinned by digest, the same discipline devcontainer-lock.json applies to the
  // features below. The tag stays in the string so a reader can see which base
  // this is; the digest is what Docker resolves. Nothing refreshes this
  // automatically — Dependabot's docker ecosystem does not read devcontainer.json
  // — so it rots until someone moves it. Re-resolve with:
  //   docker buildx imagetools inspect mcr.microsoft.com/devcontainers/base:debian-12
  "image": "mcr.microsoft.com/devcontainers/base:debian-12@sha256:23fa69fed758b7927c60061317d73baf7d66b9fca5c344e80bce3a940b229af0",
  "mounts": [
    "source=claude-data,target=/home/vscode/.claude,type=volume"
  ],
  "features": {
    // Claude Code is not a feature here: the feature installs as root, which
    // breaks auto-update. post-create.sh installs it as the container user.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "changeme",
      "webPort": "6080"
    }
  },
  "containerEnv": {
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}",
    "CONTAINER_WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "python.analysis.typeCheckingMode": "strict",
        "python.analysis.autoFormatStrings": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "always",
            "source.fixAll.ruff": "always"
          }
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh"
}
