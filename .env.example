# Copy to .env (gitignored) and fill in real values. Never commit secrets.
# Load via pydantic-settings, python-dotenv, or: set -a; . ./.env; set +a

# APP_NAME=my-app
# DEBUG=false
# LOG_LEVEL=INFO

# Secrets — generate real values; never commit a filled-in .env
# SECRET_KEY=change-me

# Database (uncomment if used)
# DATABASE_URL=postgresql://user:pass@localhost:5432/app

# Giggles bot (see docs/giggles.md). Defaults ship in the app bundle; tokens are secrets.
# SUPABASE_ANON_KEY=eyJ...            # public anon key, needed for `giggles login` and refresh
# GIGGLES_ACCESS_TOKEN=eyJ...         # or run `giggles login <email>` to save a session
# GIGGLES_REFRESH_TOKEN=...
# GIGGLES_DATA_DIR=giggles-data
# GIGGLES_MIN_INTERVAL_S=1.5
